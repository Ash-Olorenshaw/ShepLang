#include <stdio.h>

union foo {
	struct foo {
		char *name;
		c_type *type;
		bool simple; // true = val, false = val_lines
		rarray *val; // tkn
		rarray *val_lines; // tkn_line
	} var_definition;
	struct foo {
		char *name;
		c_type *type;
		rarray *tkn_lines; // tkn_line
	} func_definition;
	struct foo {
		tkn *type;
		tkn *content;
		rarray *tkn_lines; // tkn_line
	} block;
	struct foo {
		char *content;
	} macro;
	struct foo {
		rarray *tkns; // tkn
	} statement;
	struct foo {
		c_type *type;
		char *name;
	} prototype;
	struct foo {
		char *name;
	} label;
};

union foo {
	char *content;
	rarray *tkn_content;
};

int main() {
	mutable int n = 0;
	mutable int i = 0;
	printf("Enter the number of elements ");
	scanf("%d",&n);
	int a[n] = {};
	printf("Enter the elements ");
	for (i = 0; i < n; i++) {
		scanf("%d",&a[i]);
	}

	selectionSort(a, n);
	for (i = 0; i < n; i++) {
		printf("%d ", a[i]);
	}

	return 0;
}
void swap(mutable int * xp, mutable int * yp) {
	int temp = * xp;
	* xp = * yp;
	* yp = temp;
}

void selectionSort(int arr[], int n) {
	mutable int i = 0;
	mutable int j = 0;
	mutable int min_idx = 0;
	for (i = 0; i < n - 1; i++) {
		min_idx = i;
		for (j = i + 1; j < n; j++) {
			if (arr[j] < arr[min_idx]) {
				min_idx = j;
			}
		}
		swap( & arr[min_idx], & arr[i]);
	}
}

